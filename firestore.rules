rules_version = '2';

// Who may read and change what. These run on Google's servers, so they protect
// the photos even though the website itself is public.
//
//   access/{email}            = { museums: [museumId, …] }   ← the guest lists
//   museums/{museumId}        = texts, rooms, message, music info
//   museums/{museumId}/photos = photo details (+ a tiny thumbnail)
//   museums/{museumId}/images = the photo files themselves (md + lg)
//   museums/{museumId}/music  = the song, split into pieces
//   museums/{museumId}/mirror = the mirror's pictures (their bytes are in images)
//   museums/{museumId}/visits/{email} = written by each guest themselves:
//                               when they last came in, their time zone (for the
//                               clocks) and, after a proposal, when they said yes
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    // The curator. Keep this list in sync with src/firebase-config.js and database.rules.json.
    function isAdmin() {
      return signedIn() && myEmail() in ['iliasparaskevas3@gmail.com'];
    }

    // A guest of this museum: their email's access document lists it.
    function isGuest(museumId) {
      let access = /databases/$(database)/documents/access/$(myEmail());
      return signedIn() && exists(access) && museumId in get(access).data.museums;
    }

    match /access/{email} {
      allow read: if isAdmin() || (signedIn() && email == myEmail());
      allow write: if isAdmin();
    }

    match /museums/{museumId} {
      allow read: if isAdmin() || isGuest(museumId);
      allow write: if isAdmin();

      match /{part}/{docId} {
        allow read: if isAdmin() || isGuest(museumId);
        allow write: if isAdmin();
      }

      // A guest's own visit record — only their own, only these fields.
      match /visits/{email} {
        allow create, update: if isGuest(museumId) && email == myEmail()
          && request.resource.data.keys().hasOnly(['at', 'tz', 'yes', 'dodges'])
          && request.resource.data.at == request.time
          && request.resource.data.tz is string && request.resource.data.tz.size() <= 64
          && (!('yes' in request.resource.data) || request.resource.data.yes is timestamp)
          && (!('dodges' in request.resource.data) || (request.resource.data.dodges is int && request.resource.data.dodges >= 0));
      }
    }
  }
}
