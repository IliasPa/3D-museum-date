{
  "name": "our-museum",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A tiny 3D art museum of our photos \u2014 a gift.",
  "scripts": {
    "dev": "vite --host",
    "dev:emulator": "vite --host --mode emulator",
    "emulators": "firebase emulators:start --project demo-our-museum",
    "build": "vite build",
    "preview": "vite preview --host",
    "deploy:rules": "firebase deploy --only firestore,database"
  },
  "dependencies": {
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "firebase": "^13.1.0",
    "heic-to": "^1.6.6",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "vite": "^8.3.5"
  }
}
